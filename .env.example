# Chave da API do Google Gemini (usada exclusivamente no back-end Node.js)
GEMINI_API_KEY=

# Senha de acesso ao Painel do Professor e Gerador de Provas (validada apenas no back-end)
ADMIN_PASSWORD=

# Segredo criptografico para assinatura HMAC dos cookies de sessao HttpOnly
SESSION_SECRET=

# Configuracao do Firebase Admin SDK (exclusiva do back-end Node.js)
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_ID=
# Credenciais de Service Account (opcional no AI Studio/GCP quando ADC + IAM estiverem ativos)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Alternativa: JSON completo da Service Account em uma linha (opcional)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Configuracao publica do Firebase no Front-End (Vite) para OAuth do Google Docs
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
